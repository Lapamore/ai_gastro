# ===========================================
# Database Configuration
# ===========================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_gastro

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_gastro

# ===========================================
# OpenAI Configuration
# ===========================================

OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Mattermost Bot Configuration
# ===========================================

# URL вашего Mattermost сервера (без trailing slash)
MATTERMOST_URL=https://your-mattermost-server.com

# Personal Access Token бота (создается в Mattermost: Account Settings -> Security -> Personal Access Tokens)
MATTERMOST_BOT_TOKEN=your-bot-token-here

# ID команды (Team ID) - можно найти в URL команды или через API
MATTERMOST_TEAM_ID=your-team-id

# Включить/выключить Mattermost бота (true/false)
MATTERMOST_ENABLED=true

# ===========================================
# Application Settings
# ===========================================

# Режим отладки
DEBUG=false

# Порт приложения
PORT=8000
