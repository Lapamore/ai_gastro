# ===========================================
# AI Provider Configuration (AITunnel)
# ===========================================

AITUNNEL_API_KEY=sk-aitunnel-your-api-key-here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_CHAT_MODEL=gemini-2.5-flash-lite

# ===========================================
# Application Settings
# ===========================================

BACKEND_PORT=8000
SYSTEM_PROMPT_FILE=./src/core/prompts/system_prompt_gastronomy.txt

# ===========================================
# MySQL Configuration
# ===========================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=gastro_ai
MYSQL_ROOT_PASSWORD=your_root_password

# ===========================================
# YouTube API
# ===========================================

YOUTUBE_API_KEY=your-youtube-api-key-here

# ===========================================
# Mattermost Bot Configuration (optional)
# ===========================================

# URL вашего Mattermost сервера (без trailing slash)
MATTERMOST_URL=https://your-mattermost-server.com

# Personal Access Token бота
MATTERMOST_BOT_TOKEN=your-bot-token-here

# ID команды (Team ID)
MATTERMOST_TEAM_ID=your-team-id

# Включить/выключить Mattermost бота (true/false)
MATTERMOST_ENABLED=false
